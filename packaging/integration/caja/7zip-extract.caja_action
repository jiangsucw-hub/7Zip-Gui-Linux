[Caja Action]
Name=Extract Here
Tooltip=Extract archive to current folder (7-Zip File Manager)
Exec=7zip-gui-cpp --extract-here %F
Icon-Name=7zip-gui-cpp
Selection=any
Extensions=7z;zip;tar;gz;bz2;xz;rar;iso;tgz;tbz2;txz;deb;rpm;jar;apk;tar.gz;tar.bz2;tar.xz;zst;lz4;lz;lzo;lzh;lzma;arj;cab;wim;cpio;ar;z;dmg;
Groups=7-Zip File Manager;
